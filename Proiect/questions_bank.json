{
  "search_problems": {
    "category": "Search Problem",
    "problems": {
      "n_queens": {
        "name": "N Queens",
        "dynamic_rules": {
          "board_sizes": [8, 10, 12, 14, 20],
          "methods": [
            "Backtracking with pruning",
            "Backtracking with forward checking",
            "Backtracking with constraint propagation",
            "Hill climbing with random restarts",
            "Depth-first search with pruning"
          ]
        },
        "examples": [
          {
            "instance": "placing 8 queens on an 8x8 chessboard so that none attack each other",
            "strategy": "Backtracking with pruning"
          }
        ]
      },

      "graph_coloring": {
        "name": "Graph Coloring",
        "dynamic_rules": {
          "graphs": ["map of Europe", "university exam schedule", "social network graph", "radio towers network", "planar graph"],
          "methods": [
            "Backtracking with MRV heuristic",
            "Constraint satisfaction search with forward checking",
            "Backtracking with constraint propagation",
            "Least-constraining value heuristic",
            "Greedy coloring with look-ahead"
          ]
        },
        "examples": [
          {
            "instance": "coloring the regions of a map of Europe with 4 colors",
            "strategy": "Backtracking with MRV heuristic"
          }
        ]
      },

      "tower_of_hanoi": {
        "name": "Tower of Hanoi",
        "dynamic_rules": {
          "disk_counts": [3, 4, 5, 6, 7, 8, 10],
          "methods": [
            "Recursive depth-first search",
            "Recursive backtracking search",
            "Divide and conquer recursion",
            "Iterative deepening search",
            "Breadth-first search over state space"
          ]
        }
      },

      "knights_tour": {
        "name": "Knight's Tour",
        "dynamic_rules": {
          "board_sizes": [5, 6, 8, 10],
          "methods": [
            "Depth-first search with backtracking",
            "Warnsdorff’s heuristic",
            "Depth-first search with degree heuristic",
            "Constraint satisfaction search with pruning",
            "Backtracking with heuristic ordering"
          ]
        }
      },

      "pathfinding": {
        "name": "Pathfinding",
        "dynamic_rules": {
          "grid_sizes": [5, 6, 8, 10],
          "methods": [
            "A* search with Manhattan distance",
            "Dijkstra’s algorithm",
            "A* search with Euclidean distance",
            "Depth-first search",
            "Uniform cost search"
          ]
        }
      },

      "puzzle_8": {
        "name": "8-Puzzle",
        "dynamic_rules": {
          "methods": [
            "A* search with Manhattan distance heuristic",
            "A* search with misplaced tiles heuristic",
            "Iterative deepening A*",
            "Uniform cost search",
            "Greedy best-first search"
          ]
        }
      }
    }
  },

  "nash_equilibrium": {
  "category": "Game Theory",
  "examples": [

    {
      "instance": "           Player B\n          Deny     Confess\nA Deny   (-1,-1)   (-3,0)\nA Confess (0,-3)   (-2,-2)",
      "strategy": "Pure Nash equilibrium: (Confess, Confess)"
    },

    {
      "instance": "               Player B\n              Stag     Rabbit\nA Stag       (5,5)     (0,3)\nA Rabbit     (3,0)     (4,4)",
      "strategy": "Pure Nash equilibria: (Stag, Stag) and (Rabbit, Rabbit)"
    },

    {
      "instance": "                 Player B\n                 Straight    Turn\nA Straight       (-3,-3)     (3,-2)\nA Turn           (-2,3)      (-3,-3)",
      "strategy": "Pure Nash equilibria: (Straight, Turn) and (Turn, Straight)"
    },

    {
      "instance": "               Keeper\n               Left      Right\nShooter Left  (-1,1)    (1,-1)\nShooter Right (1,-1)    (-1,1)",
      "strategy": "No pure Nash equilibrium exists"
    },

    {
      "instance": "           Player B\n             X        Y\nA X        (1,1)    (2,2)\nA Y        (2,2)    (1,3)",
      "strategy": "Pure Nash equilibria: (Y, Y), (X, Y), (Y, X)"
    }

  ]
}

}
